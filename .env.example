# Copy to .env and fill in. .env is gitignored; this file holds placeholders only.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fixora

# Sign tokens with a long random value (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=replace-with-a-long-random-secret
# Session token lifetime (open item: vendors sign in with their auth code rarely).
JWT_EXPIRES=7d

LOG_LEVEL=info
UPLOAD_PATH=uploads

# Honoured ONLY when NODE_ENV is exactly development or test: then every one-time sign-in code is
# this 6-digit value (no SMS/WhatsApp provider is wired yet). Anywhere else (unset, staging,
# production) it is ignored and logged as an error at start-up. Leave it empty anywhere real.
OTP_STATIC_CODE=123456

# Proxies in front of the server to trust for the client IP (X-Forwarded-For): a hop count such as 1
# behind one load balancer, or false (default, local). Never true. The per-IP /auth limit keys on it.
TRUST_PROXY=false

# Per-IP limit on /auth/* calls per 15 minutes (in memory, per server process).
AUTH_RATE_LIMIT_MAX=100
