# Copy to .env and fill in. .env is gitignored; this file holds placeholders only.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fixora

# Sign tokens with a long random value (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=replace-with-a-long-random-secret
# Session token lifetime (open item: every sign in now needs a one-time code).
JWT_EXPIRES=7d

LOG_LEVEL=info
UPLOAD_PATH=uploads

# Honoured ONLY when NODE_ENV is exactly development or test: then every one-time sign-in code
# (customers and vendors alike) is this 6-digit value. Anywhere else (unset, staging, production)
# it is ignored and logged as an error at start-up. Leave it empty anywhere real.
OTP_STATIC_CODE=123456

# How one-time codes are delivered: none (default — recorded only, nothing is sent) or whatsapp
# (Meta WhatsApp Cloud API, an approved AUTHENTICATION template with a copy-code button). Outside
# development/test the server refuses to start with whatsapp and any of the three settings below
# missing, and logs an error at start-up with none (it starts, but nobody can sign in by phone).
# Numbers are sent as 91 + the 10-digit number.
OTP_DELIVERY_CHANNEL=none
# A system-user access token with whatsapp_business_messaging. A secret: never commit a real one.
WHATSAPP_ACCESS_TOKEN=
# The sending number's id from WhatsApp Manager (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# The approved authentication template's name and language code.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Graph API version; leave empty for the built-in default (v27.0).
WHATSAPP_API_VERSION=

# Push notifications (Firebase Cloud Messaging): the full path to the Firebase service-account JSON
# key file (Firebase console > Project settings > Service accounts > Generate new private key).
# Keep that file OUTSIDE this repository, never commit it. Empty (default) = push off: device tokens
# are still stored, nothing is sent. Outside development/test the server refuses to start if this is
# set but the file cannot be read or is not a service-account key.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Proxies in front of the server to trust for the client IP (X-Forwarded-For): a hop count such as 1
# behind one load balancer, or false (default, local). Never true. The per-IP /auth limit keys on it.
TRUST_PROXY=false

# Per-IP limit on /auth/* calls per 15 minutes (in memory, per server process).
AUTH_RATE_LIMIT_MAX=100
